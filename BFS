#include <iostream>
#include <vector>
#include <queue>


std::vector<int> BFS(const std::vector<std::vector<int>>& adj) {
    int v = adj.size();
    std::vector<bool> visited(v, false);
    std::vector<int> res;
    
    int src = 0;
    std::queue<int> q;
    
  
    visited[src] = true;
    q.push(src);
    
    while (!q.empty()) {
        int carr = q.front();
        q.pop();
        res.push_back(carr);
        
        
        for (int i : adj[carr]) {
            if (!visited[i]) {
                visited[i] = true;
                q.push(i); 
            }
        }
    }
    
    return res;
}

int main() {
    
    std::vector<std::vector<int>> adj = {
        {1, 2},    
        {0, 3},   
        {0, 3},    
        {1, 2}      
    };

    std::vector<int> result = BFS(adj);

    std::cout << "BFS Traversal: ";
    for (int node : result) {
        std::cout << node << " ";
    }
    
    return 0;
}
