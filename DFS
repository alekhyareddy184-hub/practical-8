
#include <iostream>
#include <vector>
#include <stack>
using namespace std;

void DFS(vector<vector<int>> graph, int src)
{
    int V = graph.size();

    vector<bool> visited(V, false);
    vector<int> result;

    stack<int> st;

    visited[src] = true;
    st.push(src);

    while (!st.empty())
    {
        int node = st.top();
        st.pop();

        result.push_back(node);

        for (int i : graph[node])
        {
            if (!visited[i])
            {
                visited[i] = true;
                st.push(i);
            }
        }
    }
 
    for (int i : result)
    {
        cout << i << " ";
    }
}

int main()
{
    vector<vector<int>> graph = {
        {1, 2},       // 0
        {0, 3, 4},    // 1
        {0, 5},       // 2
        {1},          // 3
        {1},          // 4
        {2}           // 5
    };

    DFS(graph, 0);

    return 0;
}
